{
  "expo": {
    "name": "MovaaGo",
    "slug": "mova",
    "scheme": "mova",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.mova.app"
    },
    "android": {
      "package": "fr.mova.app",
      "adaptiveIcon": {
        "backgroundColor": "#1C5947",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MovaaGo utilise votre position pour proposer votre adresse de départ."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MovaaGo utilise l'appareil photo pour votre photo de chauffeur, montrée au passager.",
          "photosPermission": "MovaaGo accède à vos photos si vous choisissez votre photo de chauffeur dans la galerie.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
